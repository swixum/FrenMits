<Project Sdk="Microsoft.NET.Sdk">

  <!-- The neural voice, kept in its own process on purpose.

       It carries 84MB of native code: an ONNX runtime, a 69MB phoneme dictionary
       and an audio stack. Loading that into the game would put an access violation
       in somebody's raid, and there is no catch block for those. Out here the worst
       case is that speech stops and the plugin falls back to the system voice.

       It is also why this is not in the plugin zip. It is published separately and
       fetched once by whoever actually wants it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrenAlertsVoice</AssemblyName>
    <RootNamespace>FrenAlerts.Voice</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No console window when the plugin starts it. -->
    <OutputType>WinExe</OutputType>
    <!-- Nothing here is part of the plugin build. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
  </ItemGroup>

</Project>
