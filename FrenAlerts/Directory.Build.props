<Project>

  <!-- Fren Alerts' own version. Deliberately not the repo root's, so a release
       here can never move FrenMits' version and re-ship it to everyone. Being
       the nearest props file, MSBuild stops here and the root one never applies. -->
  <PropertyGroup>
    <Version>1.0.0.10</Version>
    <AssemblyVersion>1.0.0.10</AssemblyVersion>
    <FileVersion>1.0.0.10</FileVersion>
  </PropertyGroup>

</Project>
