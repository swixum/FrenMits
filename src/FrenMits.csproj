<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FrenMits</AssemblyName>
    <RootNamespace>FrenMits</RootNamespace>
    <OutputType>Library</OutputType>
    <!-- Version lives in Directory.Build.props, shared with FrenMits.Encounters.
         Bump it there on each release, matching repo.json and FrenMits.json. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- True so the bundled NAudio assemblies land in the output. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Dalamud dev references; override DalamudLibPath if yours differ. -->
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Their own projects; the SDK's **/*.cs glob would compile them twice. -->
    <Compile Remove="FrenMits.Encounters\**;FrenMits.Callouts\**" />
    <EmbeddedResource Remove="FrenMits.Encounters\**;FrenMits.Callouts\**" />
    <None Remove="FrenMits.Encounters\**;FrenMits.Callouts\**" />
    <Content Remove="FrenMits.Encounters\**;FrenMits.Callouts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FrenMits.Encounters\FrenMits.Encounters.csproj" />
    <!-- The callout engine: events in, calls out, no Dalamud of its own. -->
    <ProjectReference Include="FrenMits.Callouts\FrenMits.Callouts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Encounter types are used almost everywhere; the assembly reference is
         what the compiler enforces, so a per-file using buys nothing. -->
    <Using Include="FrenMits.Encounters" />
    <Using Include="FrenMits.Game" />
    <Using Include="FrenMits.Ui" />
    <Using Include="FrenMits.Timing" />
    <Using Include="FrenMits.Meter" />
    <Using Include="FrenMits.Recap" />
    <Using Include="FrenMits.Prep" />
    <Using Include="FrenMits.Cues" />
    <Using Include="FrenMits.Planning" />
    <Using Include="FrenMits.Host" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FrenMits.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plugin icon, copied next to the DLL and shipped in the zip. -->
    <None Include="..\images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Relational JSON data for fights -->
    <Content Include="Data\Sheets\**\*.json" CopyToOutputDirectory="PreserveNewest" TargetPath="Sheets\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The baked calls, read by the Boss Alerts page and by the engine. -->
    <Content Include="Data\Callouts\*.fmtrig" CopyToOutputDirectory="PreserveNewest" TargetPath="Sheets\Callouts\%(Filename)%(Extension)" />
    <!-- Attribution for the derived data, shipped beside the plugin. -->
    <!-- Kept in docs, but shipped at the plugin's own root: the licence asks
         for the notice to travel with the binary, not with the repository. -->
    <None Include="..\docs\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- MP3 decode + playback for the online neural voices. Bundled into the zip. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- A DefaultAction that names a mechanic the sheet's Timeline doesn't carry
       splits one row in two in the UI and never surfaces as an error at runtime,
       so it is caught here instead. See scripts/validate-sheets.ps1. -->
  <Target Name="ValidateSheets" BeforeTargets="BeforeBuild"
          Inputs="@(Content);$(MSBuildProjectDirectory)\..\scripts\validate-sheets.ps1"
          Outputs="$(IntermediateOutputPath)sheets.validated">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\validate-sheets.ps1&quot; -SheetsPath &quot;$(MSBuildProjectDirectory)\Data\Sheets&quot;"
          StandardOutputImportance="high" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)sheets.validated" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The signature holder the damage-capture hook resolves through. -->
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
