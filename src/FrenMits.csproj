<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FrenMits</AssemblyName>
    <RootNamespace>FrenMits</RootNamespace>
    <OutputType>Library</OutputType>
    <!-- Bump on each release, matching repo.json and FrenMits.json. -->
    <Version>1.0.0.448</Version>
    <AssemblyVersion>1.0.0.448</AssemblyVersion>
    <FileVersion>1.0.0.448</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- True so the bundled NAudio assemblies land in the output. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Dalamud dev references; override DalamudLibPath if yours differ. -->
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="FrenMits.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plugin icon, copied next to the DLL and shipped in the zip. -->
    <None Include="..\images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Baked per-duty boss timelines (every instanced duty), gzipped JSON. -->
    <EmbeddedResource Include="Data\universal_timelines.json.gz" LogicalName="FrenMits.universal_timelines.json.gz" />
    <!-- Relational JSON data for fights -->
    <Content Include="Data\Sheets\**\*.json" CopyToOutputDirectory="PreserveNewest" TargetPath="Sheets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MP3 decode + playback for the online neural voices. Bundled into the zip. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- A DefaultAction that names a mechanic the sheet's Timeline doesn't carry
       splits one row in two in the UI and never surfaces as an error at runtime,
       so it is caught here instead. See scripts/validate-sheets.ps1. -->
  <Target Name="ValidateSheets" BeforeTargets="BeforeBuild"
          Inputs="@(Content);$(MSBuildProjectDirectory)\..\scripts\validate-sheets.ps1"
          Outputs="$(IntermediateOutputPath)sheets.validated">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\validate-sheets.ps1&quot; -SheetsPath &quot;$(MSBuildProjectDirectory)\Data\Sheets&quot;"
          StandardOutputImportance="high" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)sheets.validated" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The signature holder the damage-capture hook resolves through. -->
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
