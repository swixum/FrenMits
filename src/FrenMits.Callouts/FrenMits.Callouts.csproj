<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mechanic callouts: events in, calls out. This project deliberately
       references nothing at all, not Dalamud and not a JSON package, so it
       drops into the plugin solution as a project reference and builds. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AssemblyName>FrenMits.Callouts</AssemblyName>
    <RootNamespace>FrenMits.Callouts</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

</Project>
